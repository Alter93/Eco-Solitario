- X.strokeStyle="#9d5148";X.lineWidth=4;
- for(let y=170;y<550;y+=36){X.beginPath();X.moveTo(5798,y);X.lineTo(5898,y+30);X.moveTo(5898,y);X.lineTo(5798,y+30);X.stroke()}
- txt("17.8",5848,106,30,"#f0c17e","center");
